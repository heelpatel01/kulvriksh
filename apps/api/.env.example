# Example configuration for the Kulvriksh API. Placeholder values only.
# Copy to apps/api/.env for local development. .env files are git-ignored and must never be committed.

# Runtime environment: development | test | production. Default: development.
# (A separate staging environment is not decided; see roadmap R11.)
NODE_ENV=development

# Address and port the API listens on. Defaults: 127.0.0.1 and 4000.
# On the development machine port 4000 is used by another project, so `npm run db:init` writes 4100.
API_HOST=127.0.0.1
API_PORT=4100

# Log level: debug | info | warn | error | silent. Default: info.
# Logs are JSON lines; warn and error go to stderr, everything else to stdout.
LOG_LEVEL=info

# Database. `npm run db:init` writes these with generated passwords; do not commit real values.
# Outside production the host must be loopback. Two roles (data model §9.7):
#   - the API connects as the least-privilege runtime role (DATABASE_URL);
#   - Prisma migrations run as the owner role (MIGRATION_DATABASE_URL, SHADOW_DATABASE_URL).
# Without DATABASE_URL the API still starts; database-backed routes answer 503.
DATABASE_URL=postgresql://kulvriksh_app:CHANGE_ME@127.0.0.1:5434/kulvriksh
MIGRATION_DATABASE_URL=postgresql://kulvriksh_owner:CHANGE_ME@127.0.0.1:5434/kulvriksh
SHADOW_DATABASE_URL=postgresql://kulvriksh_owner:CHANGE_ME@127.0.0.1:5434/kulvriksh_shadow

# Integration tests (`npm run test:db`) use a separate database.
TEST_DATABASE_URL=postgresql://kulvriksh_app:CHANGE_ME@127.0.0.1:5434/kulvriksh_test
TEST_MIGRATION_DATABASE_URL=postgresql://kulvriksh_owner:CHANGE_ME@127.0.0.1:5434/kulvriksh_test

# Development-only shared secret (at least 32 characters) between the local web server and the API.
# Since TASK-09 it opens ONLY the development OTP outbox; admin routes need a real admin session.
# Not authentication; refused outside development.
# Must equal ADMIN_PREVIEW_TOKEN in apps/web/.env.local. Left commented out on purpose: a copied
# placeholder would be a publicly known value. Generate one, e.g. node -e "console.log(crypto.randomBytes(24).toString('base64url'))"
# ADMIN_PREVIEW_TOKEN=

# Customer sign-in (one-time code by mobile number). Without all three settings below, sign-in
# answers 503. `npm run db:secrets` adds generated values to an existing apps/api/.env.
# Two different keys, each at least 32 characters. Left commented out: a copied placeholder would
# be a publicly known key. Generate with node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# OTP_HMAC_KEY=
# RATE_LIMIT_HMAC_KEY=
# Delivery channel: none (default) | development. No SMS provider is configured yet. `development`
# keeps codes in API memory for the local sign-in page and is refused unless NODE_ENV=development.
# OTP_DELIVERY=development

# PROVISIONAL sign-in values (decisions FQ-1 to FQ-4 are open). Defaults shown; uncomment to change.
# AUTH_OTP_LENGTH=6                        # digits (6-8)
# AUTH_OTP_TTL_SECONDS=300                 # code lifetime
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_OTP_MAX_ATTEMPTS=5                  # wrong guesses per code
# AUTH_VERIFY_FAILURE_LIMIT=10             # wrong guesses per number, across codes, before lockout
# AUTH_VERIFY_FAILURE_WINDOW_SECONDS=3600
# AUTH_LOCKOUT_SECONDS=1800
# AUTH_OTP_REQUESTS_PER_NUMBER=5           # per window
# AUTH_OTP_REQUESTS_PER_IP=20              # per window
# AUTH_VERIFY_REQUESTS_PER_IP=60           # per window
# AUTH_RATE_LIMIT_WINDOW_SECONDS=3600
# AUTH_SESSION_TTL_SECONDS=604800          # absolute session lifetime (7 days)
# AUTH_SESSION_IDLE_SECONDS=86400          # idle timeout (24 hours)
# AUTH_SESSION_TOUCH_SECONDS=300           # how often last_seen_at is written
# AUTH_CUSTOMER_SIGNUP=auto                # auto: first sign-in creates the account; existing: known numbers only

# PROVISIONAL staff sign-in (R9: email + password for now; R34 second factor is open).
# AUTH_STAFF_SESSION_TTL_SECONDS=28800     # 8 hours
# AUTH_STAFF_SESSION_IDLE_SECONDS=3600     # 1 hour
# AUTH_STAFF_SIGN_IN_PER_IP=30             # per window
# AUTH_STAFF_FAILURE_LIMIT=5               # wrong passwords per account before a lockout
# AUTH_STAFF_FAILURE_WINDOW_SECONDS=900
# AUTH_STAFF_LOCKOUT_SECONDS=900

# Staff account lifecycle (TASK-10). One-time links: setup (sent by an admin) and password reset.
# AUTH_STAFF_SETUP_TOKEN_TTL_SECONDS=259200  # 72 hours
# AUTH_STAFF_RESET_TOKEN_TTL_SECONDS=3600    # 1 hour
# Second factor (R34 open): off | optional (default) | required_admins | required_all. TOTP codes.
# required_* needs STAFF_MFA_KEY (at least 32 characters, different from the HMAC keys), which
# encrypts the TOTP secrets. Left commented out: generate one, never commit it.
# STAFF_MFA=optional
# STAFF_MFA_KEY=
# R33: may admins create and manage other admins? Default false (only `npm run bootstrap:admin`).
# STAFF_ADMINS_MAY_MANAGE_ADMINS=false

# Notifications (R36/R37): channels for "report released". in_app (default) | none.
# email and sms are refused until a delivery provider is configured.
# NOTIFY_REPORT_RELEASED=in_app

# File storage (R23 limits are provisional). Only the local private-disk backend exists; no
# object-storage provider is configured. Development defaults to <repo>/.data/storage (git-ignored);
# production must set STORAGE_LOCAL_DIR or uploads answer 503.
# STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=
# MEDIA_MAX_BYTES=20971520                  # 20 MB per file
# REPORT_FILE_MAX_BYTES=26214400            # 25 MB per report PDF
# MEDIA_WORKSPACE_QUOTA_BYTES=1073741824    # 1 GB per family
# MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg,audio/ogg,audio/wav,audio/mp4
# STORAGE_ABANDONED_UPLOAD_SECONDS=3600

# DEVELOPMENT ONLY: enables `npm run dev:staff` to create test staff accounts. Refused unless
# NODE_ENV=development, and the command is not part of the production build. Never set elsewhere.
# DEV_STAFF_PROVISIONING=1

# PROVISIONAL customer profile and family settings (R8, R19).
# CUSTOMER_PROFILE_FIELDS=displayName      # comma list of accepted profile fields, or none
# FAMILY_MAX_MEMBERS=500
# FAMILY_MAX_RELATIONSHIPS=2000

# Family tree PDF export (TASK-11). All PROVISIONAL: retention is FQ-11, safe concurrency on the
# 1 vCPU / 4 GB server is measured in Phase 10, genealogist export is R28/FQ-25 (off by default).
# Admin export stays denied until FQ-14 is decided (no setting).
# EXPORT_CONCURRENCY=1                    # exports generated at once, each in its own worker thread (1-4)
# EXPORT_QUEUE_LIMIT=20                   # open exports before new requests get 429 busy
# EXPORT_TIMEOUT_SECONDS=120
# EXPORT_MAX_PAGES=300
# EXPORT_MAX_BYTES=52428800               # 50 MB
# EXPORT_WORKER_MEMORY_MB=512
# EXPORT_RETENTION_HOURS=24               # finished PDFs are deleted after this
# EXPORT_GENEALOGIST_ACCESS=off           # off | assigned

# Payments (TASK-11). none (default): plans can be managed, ordering answers 503.
# development: a simulated gateway for local development only (refused elsewhere; no money moves).
# razorpay: needs all three values below. Outside production only test keys (rzp_test_...) are
# accepted. Never commit real values; keep them in this untracked .env or a secret store.
# PAYMENT_PROVIDER=none
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_CURRENCY=INR                    # provisional (DQ-2); plans must use this currency
# PAYMENT_PROVIDER_TIMEOUT_MS=8000
# Reconciliation (FQ-18 timings are provisional): unpaid orders are re-checked with the provider.
# RECONCILE_INTERVAL_SECONDS=600
# RECONCILE_MIN_AGE_SECONDS=900
# RECONCILE_LOOKBACK_DAYS=7
# RECONCILE_BATCH_SIZE=50
# RECONCILE_ATTENTION_AFTER_CHECKS=12
# GRANT_MAX_ATTEMPTS=5
# GRANT_RETRY_SECONDS=60
# Which features need which entitlement (R14). Empty = nothing is gated. Example:
# ENTITLEMENT_GATES=tree_export=family.export

# Not yet implemented, and intentionally absent until their milestones are approved:
# - SMS, email and TTS provider credentials (M4, M7, M10)
