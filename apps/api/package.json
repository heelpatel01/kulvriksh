{
  "name": "@kulvriksh/api",
  "version": "0.0.0",
  "private": true,
  "description": "Kulvriksh Express API (foundation shell: health endpoint only).",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@kulvriksh/shared": "0.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2"
  }
}
