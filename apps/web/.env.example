# Example configuration for the Kulvriksh web app. Placeholder values only.
# Copy to apps/web/.env.local for local development (`npm run db:init` writes it for you).
# .env files are git-ignored and must never be committed.

# Internal address of the Express API, used only by the Next.js server (never sent to the browser).
# Port 4000 is used by another project on the development machine, so the API runs on 4100.
API_INTERNAL_URL=http://127.0.0.1:4100

# Development-only: must equal ADMIN_PREVIEW_TOKEN in apps/api/.env. Read only on the server, and
# used only to show the development OTP code on the sign-in page. It is not authentication: admin
# and genealogist pages need a staff sign-in. Left commented out on purpose.
# ADMIN_PREVIEW_TOKEN=

# Production site URL used for canonical links. The domain is TBC (roadmap R41).
# SITE_URL=http://localhost:3000
