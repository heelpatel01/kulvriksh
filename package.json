{
  "name": "kulvriksh-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Kulvriksh Digital Platform monorepo: Next.js web app, Express API and shared contracts.",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @kulvriksh/web",
    "dev:api": "npm run dev -w @kulvriksh/api",
    "build": "npm run build --workspaces --if-present",
    "start:web": "npm run start -w @kulvriksh/web",
    "start:api": "npm run start -w @kulvriksh/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:init": "node scripts/local-db.mjs init",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:status": "node scripts/local-db.mjs status",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:secrets": "node scripts/local-db.mjs secrets",
    "db:backup": "node scripts/local-db.mjs backup",
    "db:restore-check": "node scripts/local-db.mjs restore-check",
    "db:cleanup": "npm run cleanup -w @kulvriksh/api --",
    "dev:staff": "npm run dev:staff -w @kulvriksh/api --",
    "bootstrap:admin": "npm run bootstrap:admin -w @kulvriksh/api --",
    "test:db": "npm run test:db -w @kulvriksh/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
